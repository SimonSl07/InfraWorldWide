{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "note": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "language": {
            "type": "string",
            "minLength": 2,
            "maxLength": 5
          },
          "focus": {
            "type": "string",
            "enum": [
              "infrastructure",
              "general"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "url",
          "country",
          "language",
          "focus"
        ]
      }
    },
    "$schema": {
      "type": "string",
      "description": "Editor hint. Ignored by the loader."
    }
  },
  "required": [
    "note",
    "sources"
  ],
  "title": "InfraWorldWide news source list",
  "$comment": "Generated by scripts/emit-json-schema.ts. Do not edit by hand; run `npm run data:schema`."
}
