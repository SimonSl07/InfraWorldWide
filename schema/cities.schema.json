{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "note": {
      "type": "string",
      "minLength": 1
    },
    "cities": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2}-[a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "name": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "population": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "populationDate": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$"
          },
          "gdpPerCapita": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "currency": {
                "type": "string",
                "minLength": 3,
                "maxLength": 3
              },
              "year": {
                "type": "integer",
                "minimum": 1900,
                "maximum": 2100
              }
            },
            "required": [
              "amount",
              "currency",
              "year"
            ]
          },
          "center": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ]
          },
          "link": {
            "type": "string",
            "format": "uri"
          },
          "note": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "retrievedOn": {
                  "type": "string",
                  "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$"
                },
                "archiveUrl": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "title",
                "url"
              ]
            }
          }
        },
        "required": [
          "country",
          "name",
          "population",
          "populationDate",
          "center",
          "sources"
        ]
      }
    },
    "$schema": {
      "type": "string",
      "description": "Editor hint. Ignored by the loader."
    }
  },
  "required": [
    "note",
    "cities"
  ],
  "title": "InfraWorldWide city table",
  "$comment": "Generated by scripts/emit-json-schema.ts. Do not edit by hand; run `npm run data:schema`."
}
